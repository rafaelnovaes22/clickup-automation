{
  "$schema": "https://novais-digital.com.br/foundry/manifest-v1.json",
  "manifest_version": "0.21.0",
  "framework": {
    "name": "Novais Digital Foundry",
    "version": "0.21.0",
    "canonical": false,
    "framework_version_required": "0.21.0",
    "constitution_version": "0.3.0",
    "constitution_path": ".claude/CONSTITUTION.md",
    "constitution_sha256": "e4c69f3817eac26c"
  },
  "principles": [
    {
      "id": "C1",
      "name": "Diagnose-before-build",
      "scope": "all-categories",
      "renamed_from_v0_2_0": "Diagnose-before-design",
      "interpretation_modes": {
        "agentic_saas": "diagnostic.md por SKU/produto em produção",
        "platform": "diagnostic.md por módulo PILOT/CANONICAL crítico (financeiro, contrato, LGPD)",
        "automation": "diagnostic.md por job em produção"
      }
    },
    {
      "id": "C2",
      "name": "Outcome-first, never tech-first",
      "scope": "all-categories",
      "interpretation_modes": {
        "agentic_saas": "classified_outcome — categorias com threshold de acurácia",
        "platform": "operational_action — critério de aceite operacional + audit log entry",
        "automation": "execution_event — completed_event com payload_schema e log_location"
      }
    },
    {
      "id": "C3",
      "name": "Economic viability",
      "scope": "all-categories",
      "shadow_exemption": true,
      "renamed_from_v0_2_0": "Cost ≤ 25% of price",
      "interpretation_modes": {
        "ai_enabled_true": "cost_per_outcome (custo de inferência / preço por outcome)",
        "ai_enabled_false": "platform_margin ((infra + suporte + manutenção) / receita atribuída)"
      },
      "default_ratio_max": 0.25
    },
    {
      "id": "C4",
      "name": "Pilot-before-canonical / Shadow-before-billing",
      "scope": "all-categories",
      "renamed_from_v0_2_0": "SHADOW antes de cobrar",
      "interpretation_modes": {
        "ai_enabled_true": "SHADOW (≥14d) → ASSISTED → AUTONOMOUS",
        "ai_enabled_false": "DRAFT → STAGING → PILOT (≥14d crítico, ≥3d simple) → CANONICAL → DEPRECATED"
      }
    },
    {
      "id": "C5",
      "name": "Three-tier context",
      "scope": "all-categories"
    },
    {
      "id": "C6",
      "name": "Telemetry / auditability by default",
      "scope": "all-categories",
      "renamed_from_v0_2_0": "Telemetry-by-default",
      "interpretation_modes": {
        "ai_enabled_true": "LLM trace provider obrigatório (Langfuse/equivalente)",
        "ai_enabled_false": "audit_log_provider + structured_logging_provider obrigatórios"
      }
    },
    {
      "id": "C7",
      "name": "Portability over lock-in",
      "scope": "all-categories",
      "products_relax": "stack divergente em Beta com plano de migração",
      "expanded_in_v0_3_0": "Cobre LLMs (src/llm/), infra (src/infra/), integrações (src/integrations/), pagamentos, mensageria"
    },
    {
      "id": "C8",
      "name": "Configuration over heroic customization",
      "scope": "all-categories",
      "renamed_from_v0_2_0": "Anti-customização heroica"
    }
  ],
  "principle_extensions_path": "examples/novais-digital/constitution-extension.md",
